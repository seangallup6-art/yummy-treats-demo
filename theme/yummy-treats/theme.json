{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Yummy Treats!",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1344px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"name": "Yellow (ground)",
					"color": "#FDFF00"
				},
				{
					"slug": "contrast",
					"name": "Black",
					"color": "#000000"
				},
				{
					"slug": "accent",
					"name": "Pink (sale, dogs, LINE)",
					"color": "#FF5CC8"
				},
				{
					"slug": "accent-2",
					"name": "Blue (new, cats)",
					"color": "#45C8FF"
				},
				{
					"slug": "surface",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#3D3D3D"
				},
				{
					"slug": "line",
					"name": "Line, sold out",
					"color": "#E6E6E6"
				},
				{
					"slug": "tint-mustard",
					"name": "Tint yellow",
					"color": "#FEFFB3"
				},
				{
					"slug": "tint-raspberry",
					"name": "Tint pink",
					"color": "#FFD3F1"
				},
				{
					"slug": "tint-blue",
					"name": "Tint blue",
					"color": "#CDEFFF"
				},
				{
					"slug": "tint-green",
					"name": "Tint green",
					"color": "#D4FBD0"
				},
				{
					"slug": "tint-teal",
					"name": "Tint aqua",
					"color": "#CCF7F3"
				},
				{
					"slug": "tint-violet",
					"name": "Tint purple",
					"color": "#E8DBFF"
				},
				{
					"slug": "green",
					"name": "Green",
					"color": "#3FE26A"
				},
				{
					"slug": "purple",
					"name": "Purple",
					"color": "#B07DFF"
				},
				{
					"slug": "red",
					"name": "Red (low stock)",
					"color": "#FF6A5E"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque (display)",
					"fontFamily": "\"Bricolage Grotesque\", \"Prompt\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Space Grotesk (body)",
					"fontFamily": "\"Space Grotesk\", \"Prompt\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "thai",
					"name": "Prompt (Thai)",
					"fontFamily": "\"Prompt\", \"Noto Sans Thai\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-thai-400-normal.woff2"
							],
							"unicodeRange": "U+0E01-0E5B, U+200C-200D, U+25CC"
						},
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-thai-700-normal.woff2"
							],
							"unicodeRange": "U+0E01-0E5B, U+200C-200D, U+25CC"
						},
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-thai-800-normal.woff2"
							],
							"unicodeRange": "U+0E01-0E5B, U+200C-200D, U+25CC"
						},
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-latin-400-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-latin-700-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Prompt",
							"fontStyle": "normal",
							"fontWeight": "800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/prompt-latin-800-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "13px",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "16px",
					"fluid": {
						"min": "16px",
						"max": "17px"
					}
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "20px",
					"fluid": {
						"min": "18px",
						"max": "22px"
					}
				},
				{
					"slug": "x-large",
					"name": "Heading",
					"size": "32px",
					"fluid": {
						"min": "28px",
						"max": "40px"
					}
				},
				{
					"slug": "xx-large",
					"name": "Title",
					"size": "56px",
					"fluid": {
						"min": "40px",
						"max": "72px"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "80px",
					"fluid": {
						"min": "48px",
						"max": "112px"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "2rem"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "clamp(3rem, 6vw, 4.5rem)"
				},
				{
					"slug": "80",
					"name": "8",
					"size": "clamp(4rem, 8vw, 6rem)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "hard-sm",
					"name": "Hard 4",
					"shadow": "4px 4px 0 #000000"
				},
				{
					"slug": "hard-md",
					"name": "Hard 6",
					"shadow": "6px 6px 0 #000000"
				},
				{
					"slug": "hard-lg",
					"name": "Hard 8",
					"shadow": "8px 8px 0 #000000"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"border": {
				"width": "3px",
				"widthMobile": "2px"
			},
			"radius": {
				"pill": "999px",
				"card": "20px",
				"input": "12px",
				"block": "24px"
			},
			"shadow": {
				"sm": "4px 4px 0 #000000",
				"md": "6px 6px 0 #000000",
				"lg": "8px 8px 0 #000000"
			},
			"motion": {
				"fast": "120ms",
				"base": "200ms",
				"slow": "350ms",
				"ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
			},
			"marquee": {
				"duration": "22s"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "1.5"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			},
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1",
					"letterSpacing": "-0.03em",
					"textTransform": "lowercase"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.04em",
					"lineHeight": "0.95"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"color": "var(--wp--preset--color--contrast)",
					"width": "3px",
					"style": "solid",
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"shadow": "var(--wp--preset--shadow--hard-sm)",
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--contrast)",
						"width": "3px",
						"style": "solid",
						"offset": "3px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "var(--wp--preset--color--surface)",
							"text": "var(--wp--preset--color--contrast)"
						},
						"border": {
							"color": "var(--wp--preset--color--contrast)",
							"width": "3px",
							"style": "solid"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "14px"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"fontSize": "30px",
					"letterSpacing": "-0.03em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"letterSpacing": "-0.03em",
					"lineHeight": "1"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"width": "3px"
				}
			},
			"core/quote": {
				"border": {
					"width": "3px",
					"color": "var(--wp--preset--color--contrast)",
					"radius": "20px"
				},
				"spacing": {
					"padding": {
						"top": "1.5rem",
						"bottom": "1.5rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"woocommerce/product-price": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "20px"
				}
			},
			"woocommerce/product-button": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"woocommerce/product-sale-badge": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "999px",
					"width": "3px",
					"color": "var(--wp--preset--color--contrast)",
					"style": "solid"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"fontSize": "14px",
					"textTransform": "none"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "checkout-header",
			"title": "Checkout header",
			"area": "header"
		}
	],
	"customTemplates": [
		{
			"name": "page-stockists",
			"title": "Stockists",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-help",
			"title": "Help and contact",
			"postTypes": [
				"page"
			]
		}
	]
}
